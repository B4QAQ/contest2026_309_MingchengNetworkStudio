/******************************************************************************
 * @file        dashboard.css
 * @description 仪表盘页面样式
 * @version     10.0
 ******************************************************************************/

.greeting-row {
  flex-direction: row;
  justify-content: center;
  align-items: center;
  margin-top: 60px;
  margin-bottom: 16px;
  flex-wrap: wrap;
  width: 100%;
}

.greeting-text {
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
  text-align: center;
}

/* 3列2行，可用宽=432-2*12=408px，3张卡+2个间距：(408-16)/3=130px */
.stats-grid {
  flex-direction: row;
  flex-wrap: wrap;
  width: 408px;
  padding: 0px;
  margin-left: 12px;
}

.stat-card {
  width: 128px;
  height: 72px;
  background-color: #1a1a1a;
  border-radius: 16px;
  flex-direction: column;
  justify-content: center;
  padding: 6px 10px;
  margin-bottom: 8px;
  margin-right: 8px;
}

.stat-label {
  font-size: 22px;
  color: #888888;
  margin-bottom: 2px;
  text-align: left;
  lines: 1;
  text-overflow: ellipsis;
}

.stat-value {
  font-size: 28px;
  font-weight: bold;
  color: #ffffff;
  text-align: left;
  lines: 1;
  text-overflow: ellipsis;
}

.heatmap-title {
  font-size: 22px;
  color: #888888;
  margin-top: 8px;
  margin-bottom: 6px;
  width: 100%;
  padding-left: 12px;
}

.heatmap-container {
  flex-direction: column;
  padding: 0 64px;
}

/* 顶部日期行：标号左对齐 + 格子居中 */
.heatmap-header {
  flex-direction: row;
  margin-bottom: 4px;
  padding-left: 36px;
}

.heatmap-corner {
  width: 0px;
  height: 22px;
}

.heatmap-header-day {
  font-size: 18px;
  color: #888888;
  width: 36px;
  text-align: center;
  margin-right: 3px;
}

/* 每行：周数 + 7个热力图格 */
.heatmap-row {
  flex-direction: row;
  align-items: center;
  margin-bottom: 3px;
}

.heatmap-week {
  font-size: 18px;
  color: #888888;
  width: 36px;
  text-align: right;
  margin-right: 3px;
}

.heatmap-cell {
  width: 36px;
  height: 36px;
  border-radius: 5px;
  margin-right: 3px;
}

.heatmap-cell-hidden {
  width: 28px;
  height: 28px;
  border-radius: 4px;
  margin-right: 3px;
  background-color: transparent;
}

.heatmap-level-0 {
  background-color: #2a2a2a;
}

.heatmap-level-1 {
  background-color: #0e4429;
}

.heatmap-level-2 {
  background-color: #006d32;
}

.heatmap-level-3 {
  background-color: #26a641;
}

.heatmap-level-4 {
  background-color: #39d353;
}
