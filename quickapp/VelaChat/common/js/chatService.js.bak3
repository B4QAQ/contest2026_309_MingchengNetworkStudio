// ==================== 工具执行器 ====================

const FILE_BASE = 'internal://files/'

function executeToolCall(name, args) {
  return new Promise((resolve) => {
    try {
      switch (name) {
        case 'create_file':
          file.writeText({
            uri: FILE_BASE + args.filename,
            text: args.content || '',
            success: () => resolve('文件 ' + args.filename + ' 创建成功'),
            fail: (d, code) => resolve('创建失败，错误码: ' + code)
          })
          break
        case 'read_file':
          file.readText({
            uri: FILE_BASE + args.filename,
            success: (data) => resolve('文件内容:\n' + data.text),
            fail: (d, code) => resolve('读取失败，错误码: ' + code)
          })
          break
        case 'vibrate':
          vibrator.vibrate({ mode: args.mode || 'short' })
          resolve('已震动(' + (args.mode || 'short') + ')')
          break
        case 'set_brightness':
          brightness.setValue({
            value: Math.max(0, Math.min(255, args.value || 128)),
            success: () => resolve('亮度已设为 ' + args.value),
            fail: (d, code) => resolve('设置失败，错误码: ' + code)
          })
          break
        case 'get_brightness':
          brightness.getValue({
            success: (data) => resolve('当前亮度: ' + data.value),
            fail: (d, code) => resolve('获取亮度失败，错误码: ' + code)
          })
          break
        case 'get_device_info':
          device.getInfo({
            success: (data) => resolve('设备: ' + data.model + ', 屏幕: ' + data.screenWidth + 'x' + data.screenHeight + ', 形状: ' + data.screenShape),
            fail: () => resolve('获取设备信息失败')
          })
          break
        case 'search_file':
          file.list({
            uri: FILE_BASE,
            success: (data) => {
              const keyword = (args.keyword || '').toLowerCase()
              const matches = (data.fileList || [])
                .filter(f => f.uri.toLowerCase().indexOf(keyword) >= 0)
                .map(f => f.uri.split('/').pop())
              if (matches.length === 0) {
                resolve('未找到包含"' + args.keyword + '"的文件')
              } else {
                resolve('找到 ' + matches.length + ' 个文件:\n' + matches.join('\n'))
              }
            },
            fail: (d, code) => resolve('搜索失败，错误码: ' + code)
          })
          break
        case 'run_js':
          console.log('[ChatService] run_js 开始, filename:', args.filename)
          file.readText({
            uri: FILE_BASE + args.filename,
            success: (data) => {
              try {
                const code = data.text
                console.log('[ChatService] run_js 代码长度:', code.length)
                let output = ''
                const vconsole = {
                  log: function() {
                    const parts = []
                    for (let i = 0; i < arguments.length; i++) {
                      const arg = arguments[i]
                      if (typeof arg === 'object') {
                        try { parts.push(JSON.stringify(arg)) } catch (e) { parts.push('[Object]') }
                      } else {
                        parts.push(String(arg))
                      }
                    }
                    output += (output ? '\n' : '') + parts.join(' ')
                  },
                  error: function() {
                    const parts = []
                    for (let i = 0; i < arguments.length; i++) {
                      parts.push(String(arguments[i]))
                    }
                    output += (output ? '\n' : '') + '[ERROR] ' + parts.join(' ')
                  }
                }
                const fn = new Function('console', code)
                const start = Date.now()
                fn(vconsole)
                const elapsed = Date.now() - start
                console.log('[ChatService] run_js 执行完成, 输出:', output)
                if (!output) output = '(无输出)'

                // 写入全局控制台日志
                if (!global.consoleLogs) global.consoleLogs = []
                const d = new Date()
                const time = d.getHours().toString().padStart(2, '0') + ':' +
                             d.getMinutes().toString().padStart(2, '0') + ':' +
                             d.getSeconds().toString().padStart(2, '0')
                global.consoleLogs = global.consoleLogs.concat([{
                  code: '[AI] ' + args.filename,
                  output: output,
                  error: hasError || false,
                  time: time
                }])

                resolve('执行完成(' + elapsed + 'ms)\n输出:\n' + output)
              } catch (e) {
                console.log('[ChatService] run_js 执行失败:', e.name, e.message)
                resolve('执行失败: ' + e.name + ': ' + e.message)
              }
            },
            fail: (d, code) => {
              console.log('[ChatService] run_js 读取文件失败:', code)
              resolve('读取文件失败，错误码: ' + code)
            }
          })
          break
        default:
          resolve('未知工具: ' + name)
      }
    } catch (e) {
      resolve('工具执行异常: ' + e)
    }
  })
}

// ==================== 模型管理 ====================

let currentModel = 'mimo-v2.5-pro'

export function getAvailableModels() { return AVAILABLE_MODELS }

export async function loadModelSetting() {
  try {
    const settings = await storageManager.getSettings()
    if (settings.selectedModel) currentModel = settings.selectedModel
  } catch (e) {}
  return currentModel
}

export async function setModel(modelId) {
  currentModel = modelId
  console.log('[ChatService] 模型已切换为:', modelId)
  try { await storageManager.saveSettings({ selectedModel: modelId }) } catch (e) {}
}

export function getCurrentModel() { return currentModel }

// ==================== 消息格式 ====================

export function createMessage(role, content) {
  return {
    id: 'msg_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
    role,
    content,
    timestamp: Date.now()
  }
}

// ==================== HTTP 封装 ====================

function httpPost(url, body, auth) {
  return new Promise((resolve, reject) => {
    const header = { 'Content-Type': 'application/json' }
    if (auth) header['Authorization'] = 'Bearer ' + auth
    fetch.fetch({
      url,
      method: 'POST',
      header,
      data: JSON.stringify(body),
      responseType: 'json',
      success: (response) => {
        try {
          const res = typeof response.data === 'string' ? JSON.parse(response.data) : response.data
          resolve(res)
        } catch (e) { reject('解析失败: ' + e) }
      },
      fail: (data, code) => reject('请求失败: code=' + code)
    })
  })
}

// ==================== 直连 API ====================

async function fetchDirect(apiMessages) {
  const body = {
    model: currentModel,
    messages: apiMessages,
    tools: TOOLS,
  }
  const res = await httpPost(DIRECT_URL, body, API_KEY)
  const choice = res.choices && res.choices[0]
  if (!choice) throw 'API 无返回'
  const content = (choice.message && choice.message.content) || ''
  return {
    content: content,
    usage: res.usage || null,
    toolCalls: (choice.message && choice.message.tool_calls) || null,
  }
}

// ==================== Agent 循环 ====================

const MAX_TOOL_ROUNDS = 20

/**
 * Agent 模式 AI 回复
 * @param {Array} messages - 对话历史
 * @param {Function} onStatus - 状态回调 (status, detail)
 * @param {Function} onToolRequest - 工具请求回调，返回 Promise<boolean>，true=执行，false=拒绝
 * @return {Promise<{content, usage, toolCalls, toolLabels}>}
 */
export async function fetchAIReply(messages, onStatus, onToolRequest) {
  const apiMessages = [
    { role: 'system', content: getSystemPrompt() },
    ...messages.map(m => ({ role: m.role, content: m.content }))
  ]

  let totalUsage = null
  const allToolCalls = []
  const toolLabels = []

  if (onStatus) onStatus('thinking', '')

  for (let round = 0; round < MAX_TOOL_ROUNDS; round++) {
    console.log('[ChatService] Agent 循环, 轮次:', round + 1)
    const result = await fetchDirect(apiMessages)
    console.log('[ChatService] API 返回, content长度:', (result.content || '').length, 'toolCalls:', result.toolCalls ? result.toolCalls.length : 0)

    // 累计 usage
    if (result.usage) {
      if (!totalUsage) {
        totalUsage = result.usage
      } else {
        totalUsage.total_tokens = (totalUsage.total_tokens || 0) + (result.usage.total_tokens || 0)
      }
    }

    // 有 tool_calls — 请求用户权限后执行
    if (result.toolCalls && result.toolCalls.length > 0) {
      apiMessages.push({ role: 'assistant', content: result.content || null, tool_calls: result.toolCalls })

      for (const tc of result.toolCalls) {
        const fn = tc.function
        let args = {}
        try { args = typeof fn.arguments === 'string' ? JSON.parse(fn.arguments) : fn.arguments } catch (e) {}

        allToolCalls.push({ name: fn.name, args: args })
        const label = fn.name + ': ' + (args.filename || JSON.stringify(args))
        toolLabels.push(label)

        // 请求用户授权
        let allowed = true
        if (onToolRequest) {
          allowed = await onToolRequest(fn.name, args)
        }

        if (allowed) {
          if (onStatus) onStatus('tool', label)
          console.log('[ChatService] 执行工具:', fn.name, '参数:', JSON.stringify(args))
          try {
            const toolResult = await executeToolCall(fn.name, args)
            console.log('[ChatService] 工具结果:', toolResult)
            apiMessages.push({ role: 'tool', tool_call_id: tc.id, content: toolResult })
          } catch (e) {
            console.log('[ChatService] 工具执行异常:', e)
            apiMessages.push({ role: 'tool', tool_call_id: tc.id, content: '工具执行失败: ' + e })
          }
        } else {
          // 用户拒绝，告知模型
          apiMessages.push({ role: 'tool', tool_call_id: tc.id, content: '用户拒绝了此工具调用' })
        }
      }

      if (onStatus) onStatus('thinking', '')
      continue
    }

    // 普通文本回复
    if (onStatus) onStatus('replying', '')
    return {
      content: result.content || '',
      usage: totalUsage,
      toolCalls: allToolCalls,
      toolLabels: toolLabels
    }
  }

  throw '工具调用轮次超限'
}
