<import name="input-method" src="../../components/InputMethod/InputMethod"></import>

<template>
  <div class="container-compact">
    <div class="header-compact">
      <div class="center" @click="back()">
        <img src="/common/others/back.png" class="img-sty h24" />
        <text class="title chat-title">{{sessionTitle}}</text>
      </div>
      <text if="{{global.Screen && global.Screen.screenShape == 'rect'}}" class="title" @click="onPermissionClick()">
        <span style="color: {{permissionActive ? '#FF6B33' : '#ffffff'}};">{{prefix}}</span><span style="color: #ffffff;">{{suffix}}</span>
      </text>
    </div>

    <swiper class="chat-swiper" loop="false" indicator="false" @change="onSwiperChange">
      <!-- 第一页：对话 -->
      <scroll id="msgList" class="chat-list" scroll-y="true" bounces="true">
        <div for="{{messages}}" tid="id" class="chat-item-wrap">
          <!-- 用户消息 -->
          <div if="{{$item.role === 'user'}}" class="msg-row msg-row-user">
            <div class="msg-meta-user">
              <text class="msg-sender">{{username}}</text>
            </div>
            <div class="msg-bubble msg-bubble-user">
              <text class="msg-text msg-text-user">{{$item.content}}</text>
            </div>
          </div>

          <!-- AI 消息 -->
          <div if="{{$item.role === 'assistant'}}" class="msg-row msg-row-assistant">
            <div class="msg-meta-assistant">
              <text class="msg-model">{{modelName}}</text>
            </div>
            <!-- 工具调用标签（蓝色）- 数组渲染 -->
            <div if="{{$item.toolLabels && $item.toolLabels.length > 0 && !$item.toolRejected}}" class="msg-tool-labels">
              <text for="{{$item.toolLabels}}" class="msg-tool-text">调用: {{$item}}</text>
            </div>
            <!-- 工具拒绝标签（橙色） -->
            <div if="{{$item.toolRejected}}" class="msg-tool-label">
              <text class="msg-tool-rejected">已拒绝: {{$item.toolRejected}}</text>
            </div>
            <div class="msg-bubble msg-bubble-assistant">
              <text class="msg-text msg-text-assistant">{{$item.content}}</text>
              <!-- 工具请求选项按钮 -->
              <div if="{{$item.toolPending}}" class="tool-options">
                <div class="tool-opt-btn" @click="onToolAllow($idx, false)">
                  <text class="tool-opt-text">允许</text>
                </div>
                <div class="tool-opt-btn tool-opt-allow1h" @click="onToolAllow($idx, true)">
                  <text class="tool-opt-text">允许1小时内</text>
                </div>
                <div class="tool-opt-btn tool-opt-reject" @click="onToolReject($idx)">
                  <text class="tool-opt-text">拒绝</text>
                </div>
              </div>
              <!-- JS 执行确认按钮 -->
              <div if="{{$item.jsConfirmPending}}" class="tool-options">
                <div class="tool-opt-btn" @click="onJsConfirmAllow($idx)">
                  <text class="tool-opt-text">确认执行</text>
                </div>
                <div class="tool-opt-btn tool-opt-reject" @click="onJsConfirmReject($idx)">
                  <text class="tool-opt-text">取消</text>
                </div>
              </div>
              <!-- token/耗时 -->
              <text if="{{$item.meta}}" class="msg-meta-text">{{$item.meta.tokens}} tokens · {{$item.meta.elapsed}}s</text>
            </div>
          </div>
        </div>
      </scroll>

      // 文件列表页
      <scroll class="file-list-page" scroll-y="true" bounces="true">
        <text class="file-list-title">当前会话文件</text>
        <div if="{{sessionFiles.length === 0}}" class="file-empty">
          <text class="file-empty-text">暂无文件</text>
        </div>
        <div for="{{sessionFiles}}" tid="name" class="file-item" @click="openFile($item.name)">
          <div class="file-icon">
            <text if="{{$item.name.indexOf('.js') >= 0}}" class="file-icon-text file-icon-js">JS</text>
            <text if="{{$item.name.indexOf('.js') < 0}}" class="file-icon-text">TXT</text>
          </div>
          <div class="file-info">
            <text class="file-name">{{$item.name}}</text>
            <text class="file-time">{{$item.time}}</text>
          </div>
        </div>

        <text if="{{otherFiles.length > 0}}" class="file-list-title" style="margin-top: 12px;">其他文件</text>
        <div for="{{otherFiles}}" tid="name" class="file-item" @click="openFile($item.name)">
          <div class="file-icon">
            <text if="{{$item.name.indexOf('.js') >= 0}}" class="file-icon-text file-icon-js">JS</text>
            <text if="{{$item.name.indexOf('.js') < 0}}" class="file-icon-text">TXT</text>
          </div>
          <div class="file-info">
            <text class="file-name">{{$item.name}}</text>
            <text class="file-time">{{$item.time}}</text>
          </div>
        </div>
        <div class="bottomzw"></div>
      </scroll>

      <!-- 第三页：JS 控制台 -->
      <scroll class="console-scroll" scroll-y="true" bounces="true">
        <text class="console-title">JS 控制台</text>
        <div for="{{consoleLogs}}" class="console-log-item">
          <text class="console-log-code">{{$item.code}}</text>
          <text if="{{!$item.error}}" class="console-log-output">{{$item.output}}</text>
          <text if="{{$item.error}}" class="console-log-error">{{$item.output}}</text>
        </div>
        <div if="{{consoleLogs.length < 1}}" class="console-empty">
          <text class="console-empty-text">输入JS代码并发送</text>
        </div>
        <div class="bottomzw"></div>
      </scroll>
    </swiper>

    <!-- 脚本输入提示 -->
    <div if="{{waitingForInput}}" class="console-prompt-bar">
      <text class="console-prompt-text">{{promptMessage}}</text>
    </div>

    <div class="chat-input-bar">
      <div class="chat-input-field" @click="focusInput('chatInput')">
        <text class="chat-input-text">{{getDisplayText('chatInput')}}</text>
      </div>
      <div class="chat-send-btn center" @click="sendMessage()">
        <text class="chat-send-text">发送</text>
      </div>
    </div>

    <div if="{{showKeyboard}}" class="chat-keyboard-overlay" @click="hideKeyboard()"></div>

    <input-method
      hide="{{!showKeyboard}}"
      screentype="{{screenType}}"
      keyboardtype="QWERTY"
      maxlength="5"
      @complete="onInputComplete"
      @delete="onInputDelete"
      @cursormove="onCursorMove"
      @cursorselect="onCursorSelect"
      @copy="onCopy"
      @paste="onPaste"
      @cut="onCut"
      @selectall="onSelectAll"
    />
  </div>
</template>

<script>
import { registerPage, unregisterPage, MessageBox } from '../../common/js/uiAdm'
import { initKeyboard } from '../../common/js/useful'
import { loadMessages, saveMessages } from '../../common/js/chatStorage'
import { createMessage, fetchAIReply, getCurrentModel, loadModelSetting } from '../../common/js/chatService'
import { recordMessage } from '../../common/js/statsService'
import router from '@system.router'
import prompt from '@system.prompt'
import file from '@system.file'

export default {
  props: {
    sessionId: { default: '' },
    sessionTitle: { default: 'AI 对话' },
  },
  private: {
    showKeyboard: false,
    currentField: null,
    textParts: { chatInput: ['', ''] },
    anchor: null,
    preferredColumn: -1,
    screenType: 'rect',
    messages: [],
    isTyping: false,
    NowTime: null,
    scrclass: '',
    username: 'Felix',
    modelName: 'mimo-v2.5-pro',
    typeTimer: null,
    pendingToolResolve: null,
    pendingToolName: '',
    pendingToolArgs: {},
    // 权限轮替显示
    prefix: '',
    suffix: '',
    permissionActive: false,
    permissionTimer: null,
    // 控制台
    consoleLogs: [],
    consolePage: false,
    sessionFiles: [],
    otherFiles: [],
    // 脚本输入队列
    inputQueue: [],
    waitingForInput: false,
    promptMessage: '',
    inputBuffer: '',
    currentInputCallback: null,
  },

  onInit() {
    registerPage(this.$page.name, this)
    this.screenType = (global.Screen && global.Screen.screenShape) || 'rect'
    this.NowTime = (global.NowHour || '00') + ':' + (global.NowMin || '00')
    this.modelName = getCurrentModel()
    initKeyboard(this, 'msgList')
    this.loadMessages()
    loadModelSetting().then(() => { this.modelName = getCurrentModel() })
  },

  onShow() {
    if (global.NowHour) {
      this.NowTime = global.NowHour + ':' + global.NowMin
    }
    // 同步全局控制台日志
    if (global.consoleLogs) {
      this.consoleLogs = global.consoleLogs
    }
    // 初始化权限轮替显示
    this.startPermissionRotation()
  },

  onBackPress() {
    if (this.showKeyboard) {
      this.showKeyboard = false
      this.currentField = null
      return true
    }
    this.back()
    return true
  },

  onHide() {
    this.showKeyboard = false
    this.currentField = null
    this.stopTypeEffect()
    this.doSave()
    global.runGC()
  },

  onDestroy() {
    this.stopTypeEffect()
    this.stopPermissionRotation()
    this.doSave()
    unregisterPage(this.$page.name)
  },

  hideKeyboard() {
    if (this.showKeyboard) {
      this.showKeyboard = false
      this.currentField = null
    }
  },

  startPermissionRotation() {
    this.stopPermissionRotation()
    this.updatePermissionDisplay()

    const interval = this.permissionActive && global._toolPermission && global._toolPermission.allowAll && Date.now() < global._toolPermission.expiresAt ? 1000 : 5000

    this.permissionTimer = setInterval(() => {
      if (interval === 5000) {
        this.permissionActive = !this.permissionActive
      }
      this.updatePermissionDisplay()
    }, interval)
  },

  stopPermissionRotation() {
    if (this.permissionTimer) {
      clearInterval(this.permissionTimer)
      this.permissionTimer = null
    }
  },

  updatePermissionDisplay() {
    if (this.permissionActive && global._toolPermission && global._toolPermission.allowAll) {
      const remaining = Math.max(0, global._toolPermission.expiresAt - Date.now())
      if (remaining > 0) {
        const minutes = Math.floor(remaining / 60000)
        const seconds = Math.floor((remaining % 60000) / 1000)
        this.prefix = '绕过'
        this.suffix = ': ' + minutes.toString().padStart(2, '0') + ':' + seconds.toString().padStart(2, '0')
        return
      }
    }
    this.prefix = ''
    this.suffix = this.NowTime || '00:00'
  },

  onPermissionClick() {
    if (!this.permissionActive || !global._toolPermission || !global._toolPermission.allowAll || Date.now() >= global._toolPermission.expiresAt) {
      return
    }
    prompt.showDialog({
      title: '取消授权',
      message: '确定要取消1小时授权，回到手动模式吗？',
      buttons: [{ text: '确定取消' }, { text: '保持授权' }],
      success: (data) => {
        if (data.index === 0) {
          global._toolPermission = null
          this.permissionActive = false
          this.prefix = ''
          this.suffix = this.NowTime || '00:00'
          this.startPermissionRotation()
          MessageBox('已取消授权')
        }
      },
      fail: () => {}
    })
  },

  onPermissionClick() {
    if (!this.permissionActive || !global._toolPermission || !global._toolPermission.allowAll || Date.now() >= global._toolPermission.expiresAt) {
      return
    }
    prompt.showDialog({
      title: '取消授权',
      message: '确定要取消1小时授权，回到手动模式吗？',
      buttons: [{ text: '确定取消' }, { text: '保持授权' }],
      success: (data) => {
        if (data.index === 0) {
          global._toolPermission = null
          this.permissionActive = false
          this.prefix = ''
          this.suffix = this.NowTime || '00:00'
          this.startPermissionRotation()
          MessageBox('已取消授权')
        }
      },
      fail: () => {}
    })
  },

  onPermissionClick() {
    if (!this.permissionActive || !global._toolPermission || !global._toolPermission.allowAll || Date.now() >= global._toolPermission.expiresAt) {
      return
    }
    prompt.showDialog({
      title: '取消授权',
      message: '确定要取消1小时授权，回到手动模式吗？',
      buttons: [{ text: '确定取消' }, { text: '保持授权' }],
      success: (data) => {
        if (data.index === 0) {
          global._toolPermission = null
          this.permissionActive = false
          this.prefix = ''
          this.suffix = this.NowTime || '00:00'
          this.startPermissionRotation()
          MessageBox('已取消授权')
        }
      },
      fail: () => {}
    })
  },

  async loadMessages() {
    this.messages = await loadMessages(this.sessionId)
    this.rebuildFileList()
    if (this.messages.length > 0) {
      this.scrollToBottom()
    }
  },

  async doSave() {
    try {
      await saveMessages(this.sessionId, this.messages)
    } catch (e) {
      console.log('[Chat] 保存失败:', e)
    }
  },

  stopTypeEffect() {
    if (this.typeTimer) {
      clearTimeout(this.typeTimer)
      this.typeTimer = null
    }
  },

  startTypewriter(fullText, aiIdx) {
    return new Promise((resolve) => {
      let i = 0
      const totalLen = fullText.length
      const delay = totalLen <= 20 ? 80 : totalLen <= 100 ? 40 : 20

      const typeNext = () => {
        if (i < totalLen) {
          i++
          const updated = this.messages.slice()
          const cur = updated[aiIdx]
          updated[aiIdx] = {
            id: cur.id, role: 'assistant', content: fullText.slice(0, i),
            timestamp: cur.timestamp, toolLabels: cur.toolLabels,
            toolRejected: cur.toolRejected, meta: cur.meta
          }
          this.messages = updated
          this.typeTimer = setTimeout(typeNext, delay)
        } else {
          this.typeTimer = null
          this.scrollToBottom()
          resolve()
        }
      }
      this.typeTimer = setTimeout(typeNext, 200)
    })
  },

  // 文件列表管理
  rebuildFileList() {
    const files = []
    for (const msg of this.messages) {
      if (msg.role === 'assistant' && msg.toolLabels) {
        for (const label of msg.toolLabels) {
          if (label.indexOf('create_file') >= 0) {
            const parts = label.split(': ')
            const name = parts.length > 1 ? parts[1] : label
            const d = new Date(msg.timestamp)
            const time = (d.getMonth() + 1).toString().padStart(2, '0') + '/' +
                         d.getDate().toString().padStart(2, '0') + ' ' +
                         d.getHours().toString().padStart(2, '0') + ':' +
                         d.getMinutes().toString().padStart(2, '0')
            files.push({ name: name, time: time, sessionId: this.sessionId })
          }
        }
      }
    }
    this.sessionFiles = files
    this.loadAllFiles()
  },

  async loadAllFiles() {
    try {
      file.list({
        uri: 'internal://files/',
        success: (data) => {
          const allFiles = (data.fileList || [])
            .filter(f => f.uri.endsWith('.txt') || f.uri.endsWith('.js') || f.uri.endsWith('.json'))
            .filter(f => !f.uri.includes('settings.json') && !f.uri.includes('sessions.json') && !f.uri.includes('stats.json'))
            .map(f => {
              const name = f.uri.split('/').pop()
              return { name: name, time: '', sessionId: '' }
            })
          const sessionNames = this.sessionFiles.map(f => f.name)
          this.otherFiles = allFiles.filter(f => sessionNames.indexOf(f.name) < 0)
        },
        fail: () => { this.otherFiles = [] }
      })
    } catch (e) {
      this.otherFiles = []
    }
  },

  addCreatedFile(name) {
    const d = new Date()
    const time = (d.getMonth() + 1).toString().padStart(2, '0') + '/' +
                 d.getDate().toString().padStart(2, '0') + ' ' +
                 d.getHours().toString().padStart(2, '0') + ':' +
                 d.getMinutes().toString().padStart(2, '0')
    this.sessionFiles = this.sessionFiles.concat([{ name: name, time: time, sessionId: this.sessionId }])
  },

  openFile(filename) {
    router.push({ uri: '/pages/chat/viewer', params: { filename: filename } })
  },

  // 工具权限
  askToolPermission(toolName, args) {
    // search_file 不需要权限
    if (toolName === 'search_file') {
      return Promise.resolve(true)
    }

    // 检查 1 小时内免确认
    if (global._toolPermission && global._toolPermission.allowAll) {
      if (Date.now() < global._toolPermission.expiresAt) {
        return Promise.resolve(true)
      }
      global._toolPermission = null
    }

    // 在 AI 消息上显示工具请求选项
    const aiIdx = this.messages.length - 1
    if (aiIdx >= 0) {
      const updated = this.messages.slice()
      updated[aiIdx] = Object.assign({}, updated[aiIdx], {
        content: '请求调用: ' + toolName,
        toolPending: true
      })
      this.messages = updated
    }

    // 记录当前请求的工具名
    this.pendingToolName = toolName
    this.pendingToolArgs = args

    return new Promise((resolve) => {
      this.pendingToolResolve = resolve
    })
  },

  // run_js 二次确认
  confirmJsExecution(args) {
    const filename = args && args.filename ? args.filename : '脚本'
    return new Promise((resolve) => {
      prompt.showDialog({
        title: 'JS 执行确认',
        message: '即将运行: ' + filename,
        buttons: [{ text: '确认执行' }, { text: '取消' }],
        success: (data) => {
          resolve(data.index === 0)
        },
        fail: () => {
          resolve(false)
        }
      })
    })
  },

  onJsConfirmAllow(msgIdx) {
    const updated = this.messages.slice()
    updated[msgIdx] = Object.assign({}, updated[msgIdx], { jsConfirmPending: false, content: '执行中...' })
    this.messages = updated
    if (this.pendingToolResolve) {
      this.pendingToolResolve(true)
      this.pendingToolResolve = null
    }
  },

  onJsConfirmReject(msgIdx) {
    const updated = this.messages.slice()
    updated[msgIdx] = Object.assign({}, updated[msgIdx], { jsConfirmPending: false, content: '已取消执行' })
    this.messages = updated
    if (this.pendingToolResolve) {
      this.pendingToolResolve(false)
      this.pendingToolResolve = null
    }
  },

  onToolAllow(msgIdx, allowAll) {
    if (allowAll) {
      global._toolPermission = { allowAll: true, expiresAt: Date.now() + 3600000 }
    }

    const updated = this.messages.slice()
    updated[msgIdx] = Object.assign({}, updated[msgIdx], { toolPending: false, content: '思考中' })
    this.messages = updated
    if (this.pendingToolResolve) {
      this.pendingToolResolve(true)
      this.pendingToolResolve = null
    }
    this.pendingToolName = null
    this.pendingToolArgs = null
  },

  onToolReject(msgIdx) {
    const updated = this.messages.slice()
    const toolName = updated[msgIdx].content.replace('请求调用: ', '')
    updated[msgIdx] = Object.assign({}, updated[msgIdx], {
      toolPending: false,
      toolRejected: toolName,
      content: '思考中'
    })
    this.messages = updated
    if (this.pendingToolResolve) {
      this.pendingToolResolve(false)
      this.pendingToolResolve = null
    }
  },

  async sendMessage() {
    const parts = this.textParts.chatInput
    const text = parts.join('').trim()
    if (!text) return

    this.textParts.chatInput = ['', '']
    this.anchor = null
    this.showKeyboard = false
    this.currentField = null

    // 如果正在等待脚本输入，把文字填入 inputBuffer 并确认
    if (this.waitingForInput) {
      this.inputBuffer = text
      this.onInputConfirm()
      return
    }

    // 控制台页：直接运行 JS
    if (this.consolePage) {
      console.log('[Chat] sendMessage - consolePage=true, text:', text)
      this.runJsCode(text)
      return
    }

    // 对话页：发送聊天消息
    if (this.isTyping) {
      MessageBox('AI 正在回复中...')
      return
    }

    console.log('[Chat] sendMessage 开始:', text)

    const userMsg = createMessage('user', text)
    this.messages = this.messages.concat([userMsg])
    this.scrollToBottom()

    this.isTyping = true
    recordMessage('user')

    const aiId = 'msg_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6)
    const aiMsg = { id: aiId, role: 'assistant', content: '思考中', timestamp: Date.now() }
    this.messages = this.messages.concat([aiMsg])
    this.scrollToBottom()

    const requestStart = Date.now()

    try {
      console.log('[Chat] fetchAIReply 开始')
      const result = await fetchAIReply(
        this.messages.slice(0, -1),
        (status, detail) => {
          const updated = this.messages.slice()
          const idx = updated.findIndex(m => m.id === aiId)
          if (idx >= 0) {
            if (status === 'tool') {
              if (!updated[idx].toolLabels) updated[idx].toolLabels = []
              updated[idx].toolLabels.push(detail)
              updated[idx].content = '思考中'
            } else if (status === 'thinking') {
              updated[idx].content = '思考中'
            } else if (status === 'replying') {
              updated[idx].content = '正在回复'
            }
            this.messages = updated
          }
        },
        async (toolName) => {
          return await this.askToolPermission(toolName)
        }
      )
      console.log('[Chat] fetchAIReply 完成, content长度:', (result.content || '').length)

      const elapsed = ((Date.now() - requestStart) / 1000).toFixed(1)
      const tokens = result.usage ? result.usage.total_tokens || 0 : 0

      // 追踪创建的文件
      if (result.toolCalls) {
        for (const tc of result.toolCalls) {
          if (tc.name === 'create_file' && tc.args && tc.args.filename) {
            this.addCreatedFile(tc.args.filename)
          }
        }
      }

      const finalIdx = this.messages.findIndex(m => m.id === aiId)
      console.log('[Chat] startTypewriter 开始, finalIdx:', finalIdx)
      await this.startTypewriter(result.content || '', finalIdx)

      const updated = this.messages.slice()
      const idx = updated.findIndex(m => m.id === aiId)
      if (idx >= 0) {
        updated[idx].meta = { tokens: tokens, elapsed: elapsed }
        this.messages = updated
      }

      recordMessage('assistant', result.usage)
      this.doSave()
      this.scrollToBottom()
    } catch (e) {
      console.log('[Chat] sendMessage 错误:', e)
      this.stopTypeEffect()
      const updated = this.messages.slice()
      const idx = updated.findIndex(m => m.id === aiId)
      if (idx >= 0) {
        updated[idx] = { id: aiId, role: 'assistant', content: '请求失败', timestamp: aiMsg.timestamp }
        this.messages = updated
      }
    }
    this.isTyping = false
  },

  scrollToBottom() {
    const el = this.$element('msgList')
    if (el) {
      setTimeout(() => {
        el.scrollTo({ top: 999999, behavior: 'smooth' })
      }, 100)
    }
  },

  // JS 运行（控制台页调用）
  runJsCode(code) {
    if (!code || !code.trim()) return
    console.log('[Chat] runJsCode 开始, code:', code)

    let output = ''
    let hasError = false

    // 支持 /run filename.js 语法（不需要引号）
    if (code.trim().startsWith('/run ')) {
      const filename = code.trim().substring(5).trim()
      if (filename) {
        this.runFile(filename)
        return
      }
    }

    const vconsole = {
      log: function() {
        const parts = []
        for (let i = 0; i < arguments.length; i++) {
          const arg = arguments[i]
          if (typeof arg === 'object') {
            try { parts.push(JSON.stringify(arg)) } catch (e) { parts.push('[Object]') }
          } else {
            parts.push(String(arg))
          }
        }
        output += (output ? '\n' : '') + parts.join(' ')
      },
      error: function() {
        const parts = []
        for (let i = 0; i < arguments.length; i++) {
          parts.push(String(arguments[i]))
        }
        output += (output ? '\n' : '') + '[ERROR] ' + parts.join(' ')
        hasError = true
      }
    }

    const vinput = (message, callback) => {
      if (typeof message === 'function') {
        callback = message
        message = '请输入'
      }
      this.inputQueue.push({ message: String(message || '请输入'), callback })
      this.processInputQueue()
    }

    const vrun = (filename) => {
      if (!filename) return
      const name = String(filename).replace(/^["']|["']$/g, '')
      this.runFile(name)
    }

    // 预处理：给 run(xxx) 中不带引号的参数加上引号
    let processedCode = code
    if (code.match(/run\s*\([^"'][^)]*[^"']\)/)) {
      processedCode = code.replace(/run\s*\(([^"'][^)]*)\)/g, function(match, arg) {
        const trimmed = arg.trim()
        return 'run("' + trimmed + '")'
      })
    }

    try {
      const fn = new Function('console', 'input', 'prompt', 'run', processedCode)
      fn(vconsole, vinput, vinput, vrun)
      if (!output) output = '(无输出)'
    } catch (e) {
      output = e.name + ': ' + e.message
      hasError = true
    }

    console.log('[Chat] runJsCode 输出:', output, 'hasError:', hasError)

    const d = new Date()
    const time = d.getHours().toString().padStart(2, '0') + ':' +
                 d.getMinutes().toString().padStart(2, '0') + ':' +
                 d.getSeconds().toString().padStart(2, '0')

    // 写入全局控制台日志
    if (!global.consoleLogs) global.consoleLogs = []
    global.consoleLogs = global.consoleLogs.concat([{
      code: code,
      output: output,
      error: hasError,
      time: time
    }])

    // 同步到页面变量（用于模板显示）
    this.consoleLogs = global.consoleLogs
    console.log('[Chat] runJsCode consoleLogs长度:', this.consoleLogs.length)
  },

  processInputQueue() {
    if (this.waitingForInput || this.inputQueue.length === 0) return
    const { message, callback } = this.inputQueue.shift()
    this.promptMessage = message
    this.waitingForInput = true
    this.currentInputCallback = callback
  },

  onInputConfirm() {
    const value = this.inputBuffer || ''
    this.promptMessage = ''
    this.waitingForInput = false
    this.inputBuffer = ''
    if (this.currentInputCallback) {
      try {
        this.currentInputCallback(value)
      } catch (e) {
        console.log('[Chat] input callback error:', e)
      }
      this.currentInputCallback = null
    }
    // 处理下一个 input 请求
    setTimeout(() => { this.processInputQueue() }, 100)
  },

  runFile(filename) {
    console.log('[Chat] runFile 开始, filename:', filename)
    file.readText({
      uri: 'internal://files/' + filename,
      success: (data) => {
        try {
          const code = data.text
          console.log('[Chat] runFile 读取成功, 代码长度:', code.length)

          let output = ''
          let hasError = false

          const vconsole = {
            log: function() {
              const parts = []
              for (let i = 0; i < arguments.length; i++) {
                const arg = arguments[i]
                if (typeof arg === 'object') {
                  try { parts.push(JSON.stringify(arg)) } catch (e) { parts.push('[Object]') }
                } else {
                  parts.push(String(arg))
                }
              }
              output += (output ? '\n' : '') + parts.join(' ')
            },
            error: function() {
              const parts = []
              for (let i = 0; i < arguments.length; i++) {
                parts.push(String(arguments[i]))
              }
              output += (output ? '\n' : '') + '[ERROR] ' + parts.join(' ')
              hasError = true
            }
          }

          const vinput = (message, callback) => {
            if (typeof message === 'function') {
              callback = message
              message = '请输入'
            }
            this.inputQueue.push({ message: String(message || '请输入'), callback })
            this.processInputQueue()
          }

          const vrun = (filename2) => {
            this.runFile(filename2)
          }

          const fn = new Function('console', 'input', 'prompt', 'run', code)
          fn(vconsole, vinput, vinput, vrun)

          if (!output) output = '(无输出)'
          console.log('[Chat] runFile 输出:', output)

          // 写入全局控制台日志
          if (!global.consoleLogs) global.consoleLogs = []
          const d = new Date()
          const time = d.getHours().toString().padStart(2, '0') + ':' +
                       d.getMinutes().toString().padStart(2, '0') + ':' +
                       d.getSeconds().toString().padStart(2, '0')
          global.consoleLogs = global.consoleLogs.concat([{
            code: '[文件] ' + filename,
            output: output,
            error: hasError,
            time: time
          }])
          this.consoleLogs = global.consoleLogs
        } catch (e) {
          console.log('[Chat] runFile 执行失败:', e)
          if (!global.consoleLogs) global.consoleLogs = []
          const d = new Date()
          const time = d.getHours().toString().padStart(2, '0') + ':' +
                       d.getMinutes().toString().padStart(2, '0') + ':' +
                       d.getSeconds().toString().padStart(2, '0')
          global.consoleLogs = global.consoleLogs.concat([{
            code: '[文件] ' + filename,
            output: e.name + ': ' + e.message,
            error: true,
            time: time
          }])
          this.consoleLogs = global.consoleLogs
        }
      },
      fail: (d, code) => {
        console.log('[Chat] runFile 读取失败:', code)
        if (!global.consoleLogs) global.consoleLogs = []
        const d2 = new Date()
        const time = d2.getHours().toString().padStart(2, '0') + ':' +
                     d2.getMinutes().toString().padStart(2, '0') + ':' +
                     d2.getSeconds().toString().padStart(2, '0')
        global.consoleLogs = global.consoleLogs.concat([{
          code: '[文件] ' + filename,
          output: '读取失败，错误码: ' + code,
          error: true,
          time: time
        }])
        this.consoleLogs = global.consoleLogs
      }
    })
  },
}
</script>

<style>
@import '../../common/css/chat.css';
@import '../../common/css/loading.css';
</style>
