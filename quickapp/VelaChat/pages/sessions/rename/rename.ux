<import name="input-method" src="../../../components/InputMethod/InputMethod"></import>

<template>
  <div class="container-compact">
    <div class="header-compact">
      <div class="center">
        <text class="title">重命名</text>
      </div>
      <text if="{{global.Screen && global.Screen.screenShape == 'rect'}}" class="title">{{NowTime}}</text>
    </div>

    <div class="rename-area">
      <text class="rename-label">当前名称</text>
      <div class="rename-input-field" @click="focusInput('nameInput')">
        <text class="rename-input-text">{{getDisplayText('nameInput')}}</text>
      </div>
      <div class="rename-actions">
        <div class="rename-btn rename-btn-cancel" @click="back()">
          <text class="rename-btn-text">取消</text>
        </div>
        <div class="rename-btn rename-btn-save" @click="doSave()">
          <text class="rename-btn-text">保存</text>
        </div>
      </div>
    </div>

    <div if="{{showKeyboard}}" class="rename-keyboard-overlay" @click="hideKeyboard()"></div>

    <input-method
      hide="{{!showKeyboard}}"
      screentype="{{screenType}}"
      keyboardtype="QWERTY"
      maxlength="5"
      @complete="onInputComplete"
      @delete="onInputDelete"
      @cursormove="onCursorMove"
      @cursorselect="onCursorSelect"
      @copy="onCopy"
      @paste="onPaste"
      @cut="onCut"
      @selectall="onSelectAll"
    />
  </div>
</template>

<script>
import { registerPage, unregisterPage, MessageBox } from '../../../common/js/uiAdm'
import { initKeyboard } from '../../../common/js/useful'
import { renameSession } from '../../../common/js/chatStorage'

export default {
  props: {
    sessionId: { default: '' },
    currentTitle: { default: '' },
  },
  private: {
    showKeyboard: false,
    currentField: null,
    textParts: { nameInput: ['', ''] },
    anchor: null,
    preferredColumn: -1,
    screenType: 'rect',
    NowTime: null,
    scrclass: '',
  },

  onInit() {
    registerPage(this.$page.name, this)
    this.screenType = (global.Screen && global.Screen.screenShape) || 'rect'
    this.NowTime = (global.NowHour || '00') + ':' + (global.NowMin || '00')
    initKeyboard(this, 'mainScl')
    // 把当前名称填入输入区
    this.textParts.nameInput = [this.currentTitle || '', '']
  },

  onShow() {
    if (global.NowHour) {
      this.NowTime = global.NowHour + ':' + global.NowMin
    }
  },

  onBackPress() {
    if (this.showKeyboard) {
      this.showKeyboard = false
      this.currentField = null
      return true
    }
    this.back()
    return true
  },

  onDestroy() {
    unregisterPage(this.$page.name)
  },

  hideKeyboard() {
    if (this.showKeyboard) {
      this.showKeyboard = false
      this.currentField = null
    }
  },

  async doSave() {
    const parts = this.textParts.nameInput
    const name = parts.join('').trim()
    if (!name) {
      MessageBox('名称不能为空')
      return
    }
    try {
      await renameSession(this.sessionId, name)
      MessageBox('已保存')
      this.back()
    } catch (e) {
      MessageBox('保存失败')
    }
  },
}
</script>

<style>
@import '../../../common/css/rename.css';
@import '../../../common/css/loading.css';
</style>
