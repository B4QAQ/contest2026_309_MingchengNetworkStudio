# Audio stack: AUDIO_NULL is a host-side stub that lets nxplayer / nxcapture
# register without a real I2S codec.  nxplayer commands become available
# so a future I2S port can be a drop-in.  libhelix-mp3 is the MP3 decoder
# the audio path needs.
#---------------------------------------------------------------------------
CONFIG_AUDIO=y
CONFIG_AUDIO_NULL=y
CONFIG_AUDIOUTILS_NXPLAYER=y
CONFIG_AUDIOUTILS_NXPLAYER_NXRECORDER=y
CONFIG_LIB_HELIX_MP3=y

#---------------------------------------------------------------------------
# RK3506 SPI controller (DesignWare SSI compatible, polling mode) + SPI
# NAND GD5F upper-half.  The driver lives in
# vendor/rockchip/chips/rk3506/rk3506_spi.c (controller) and
# rk3506_spinand.c (gd5f glue).  It exercises the existing NuttX
# drivers/mtd/gd5f.c upper-half via SPI1 CS0 at 1 MHz.
#
# The high-performance FSPI host (0xFF488000, IRQ 85, quad-mode) is
# still not wired up; this is the 1-bit SPI fallback.
#---------------------------------------------------------------------------
CONFIG_RK3506_SPI=y
CONFIG_RK3506_SPINAND=y
CONFIG_MTD_GD5F=y
CONFIG_RK3506_FSPI=y
CONFIG_GD5F_SPIFREQUENCY=1000000
CONFIG_GD5F_SPIMODE=0

#---------------------------------------------------------------------------
# GMAC0 Ethernet (eth0) - Synopsys DWMAC 4.20a @ 0xFF4C8000, IRQ66.
# PHY: YT8512B RMII @ MDIO addr 0, reset GPIO4_A2 active low; RMII
# REF_CLK direction = INPUT (the PHY's crystal-locked 50 MHz feeds
# GPIO2_B2), per the HD-RK3506-EVM board doc GMAC.md:
#   clock_in_out = "input"  ->  CONFIG_RK3506_GMAC0_EXTCLK=y
#   (GRF_SOC_CON8 bit5 = SELET_IO; the "output" default is the
#   Rockchip in-house EVM wiring and dead-ends this board's link).
#---------------------------------------------------------------------------
CONFIG_RK3506_GMAC0=y
CONFIG_RK3506_GMAC0_EXTCLK=y
