# PHY-status ioctls (SIOCMIINOTIFY/SIOCGMIIPHY/SIOCGMIIREG on the GMAC0
# driver).  NOTE: do NOT enable NETINIT_MONITOR with this driver yet --
# the monitor thread calls ifup/ifdown and MDIO ioctls concurrently with
# the link poll, and the driver's ifup sleeps up to 5s holding netdev
# locks, which stalls every socket operation (dhcp/ping/curl freeze).
CONFIG_NETDEV_PHY_IOCTL=y
CONFIG_NSH_NETINIT=y
CONFIG_NSH_DHCPC=y
# DHCP at boot: netutils/netinit drives the address setup (nsh_init ->
# netinit_bringup); NETINIT_DHCPC is the switch it actually consumes
# (NSH_DHCPC above is a legacy no-op symbol).  NETINIT_THREAD moves the
# whole bring-up (link wait + DHCP) off the NSH main task so the prompt
# is not delayed by the ~4s RMII autoneg.
CONFIG_NETINIT_DHCPC=y
CONFIG_NETINIT_THREAD=y
# Boot DHCP robustness: switch/router ports commonly sit in STP
# listening/learning for 10-30s after link-up, dropping BOOTP broadcasts.
# With the default 3 retries (~9s) the netinit one-shot DHCP fails
# SILENTLY (netinit_net_bringup just returns, no error print) and the
# board boots at 0.0.0.0; 10 retries (~30s) cover a typical STP
# forward-delay window.
CONFIG_NETUTILS_DHCPC_RETRIES=10
# DNS: netinit preseeds the resolver with the LAN gateway so name
# resolution works even when the DHCP ACK carries no DNS option
# (192.168.10.1 = typical HD-RK3506 bench router).  A DHCP-provided
# DNS server overwrites this at boot.  Also shorten the resolver
# recv timeout: with the default 30s x 3 retries a dead nameserver
# stalls every lookup for up to 90s (curl/ping "hang").
CONFIG_NETINIT_DNS=y
CONFIG_NETINIT_DNSIPADDR=0xc0a80a01
CONFIG_NETDB_DNSCLIENT_RECV_TIMEOUT=5
