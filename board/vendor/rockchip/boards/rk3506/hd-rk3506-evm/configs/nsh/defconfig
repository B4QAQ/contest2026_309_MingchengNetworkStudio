# every TLS certificate looks "not yet valid" (curl: BADCERT_FUTURE).
# SYSTEM_NTPC provides the ntpcstart/ntpcstop/ntpcstatus commands;
# rcS starts the daemon so the clock syncs once the network is up even
# if boot DHCP needed the manual `ifconfig eth0 dhcp`.  netinit also
# starts it after a successful DHCP (state-locked, no double start).
CONFIG_SYSTEM_NTPC=y
# NSH date command: shows/sets the system clock.  Kconfig auto-disables
